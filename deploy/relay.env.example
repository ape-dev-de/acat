# acat-relay configuration (environment variables only).

# --- Network ---
# ACAT_TLS_MODE=proxy            # proxy (default, behind reverse proxy) | autocert (relay terminates TLS on :80/:443)
# ACAT_LISTEN_ADDR=:8080         # proxy mode only
# ACAT_DOMAIN=relay.example.org  # required for autocert
# ACAT_CERT_DIR=/certs           # autocert cache; mount a volume here
# ACAT_TRUSTED_PROXIES=172.16.0.0/12   # CIDRs/IPs whose X-Forwarded-For is trusted (rate limiting)
# ACAT_METRICS_ADDR=:9090        # Prometheus /metrics on a separate, non-public listener; empty = off

# --- Limits ---
# ACAT_MAX_BODY_BYTES=65536      # max webhook body
# ACAT_MAX_CONNS_PER_IP=256      # concurrent WebSockets per client IP (keep high for corporate NAT)

# --- ACS token exchange (from M8) ---
# ACAT_ACS_CONNECTION_STRING=endpoint=https://<name>.communication.azure.com/;accesskey=<key>
# ACAT_ALLOWED_TENANTS=<tenant-guid>,<tenant-guid>
