# acat-relay configuration (environment variables only).
# ACAT_TLS_MODE=proxy|autocert   (compose sets proxy)
# ACAT_DOMAIN=relay.example.org  (required for autocert)
# ACAT_TRUSTED_PROXIES=172.16.0.0/12   (from M5: source of client IPs for rate limiting)
# ACAT_ACS_CONNECTION_STRING=endpoint=https://<name>.communication.azure.com/;accesskey=<key>   (from M8)
# ACAT_ALLOWED_TENANTS=<tenant-guid>,<tenant-guid>   (from M8, optional)
